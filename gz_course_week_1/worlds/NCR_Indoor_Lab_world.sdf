<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="NCR_Indoor_Lab">
    <include>
      <name>tb3</name>
      <pose>0 0 0.05 0 0 0</pose>
      <uri>model://turtlebot3_burger</uri>
    </include>
    <gravity>0 0 -9.81</gravity>
    <plugin
      filename="gz-sim-physics-system"
      name="gz::sim::systems::Physics">
    </plugin>
    <plugin
      filename="gz-sim-user-commands-system"
      name="gz::sim::systems::UserCommands">
    </plugin>
    <plugin
      filename="gz-sim-scene-broadcaster-system"
      name="gz::sim::systems::SceneBroadcaster">
    </plugin>
    <plugin
      filename="gz-sim-imu-system"
      name="gz::sim::systems::Imu">
    </plugin>
    <plugin
      filename="gz-sim-sensors-system"
      name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <scene>
      <ambient>0.7 0.7 0.7 1.0</ambient>
      <background>0.95 0.95 0.95 1.0</background>
    </scene>
    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.85 0.85 0.85 1.0</diffuse>
      <specular>0.2 0.2 0.2 1.0</specular>
      <direction>-0.4 0.2 -1.0</direction>
    </light>
    <!-- Floor is deliberately larger (15.5 x 23.5) than the room's wall
         footprint (5.5 x 13.5, see the *_wall_marker models below):
         5 m of margin on every side beyond the wall markers, centered on
         the same (0, 0) point so the room stays centered on it -- this
         also matches the robot's spawn pose below, so the robot starts
         at the room's actual center, not just world origin. The
         wall markers are collision-free, so under cbf:=false (or a CBF
         that fails to hold the robot inside) the robot can physically
         drive past them; this margin keeps it from immediately falling off
         the floor's edge into the void the moment it crosses a marker. -->
    <model name="floor">
      <static>true</static>
      <link name="link">
        <pose>0 0 -0.05 0 0 0</pose>
        <collision name="collision">
          <geometry>
            <box>
              <size>15.5 23.5 0.1</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>15.5 23.5 0.1</size>
            </box>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.8 1.0</ambient>
            <diffuse>0.8 0.8 0.8 1.0</diffuse>
          </material>
        </visual>
      </link>
    </model>
    <!-- Original walls are replaced with flat, collision-free floor
         markers at the same footprint, so the robot can only be stopped
         by the CBF safety filter, not by physically hitting a wall. -->
    <model name="west_wall_marker">
      <static>true</static>
      <link name="link">
        <pose>-2.775 0 0.01 0 0 0</pose>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.05 13.5 0.02</size>
            </box>
          </geometry>
          <material>
            <ambient>1.0 0.0 0.0 1.0</ambient>
            <diffuse>1.0 0.0 0.0 1.0</diffuse>
          </material>
        </visual>
      </link>
    </model>
    <model name="east_wall_marker">
      <static>true</static>
      <link name="link">
        <pose>2.775 0 0.01 0 0 0</pose>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.05 13.5 0.02</size>
            </box>
          </geometry>
          <material>
            <ambient>1.0 0.0 0.0 1.0</ambient>
            <diffuse>1.0 0.0 0.0 1.0</diffuse>
          </material>
        </visual>
      </link>
    </model>
    <model name="north_wall_marker">
      <static>true</static>
      <link name="link">
        <pose>0 6.775 0.01 0 0 0</pose>
        <visual name="visual">
          <geometry>
            <box>
              <size>5.5 0.05 0.02</size>
            </box>
          </geometry>
          <material>
            <ambient>1.0 0.0 0.0 1.0</ambient>
            <diffuse>1.0 0.0 0.0 1.0</diffuse>
          </material>
        </visual>
      </link>
    </model>
    <model name="south_wall_marker">
      <static>true</static>
      <link name="link">
        <pose>0 -6.775 0.01 0 0 0</pose>
        <visual name="visual">
          <geometry>
            <box>
              <size>5.5 0.05 0.02</size>
            </box>
          </geometry>
          <material>
            <ambient>1.0 0.0 0.0 1.0</ambient>
            <diffuse>1.0 0.0 0.0 1.0</diffuse>
          </material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
